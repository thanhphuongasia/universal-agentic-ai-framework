# Copy to .env (which is .gitignored) and fill in real values.
# NEVER commit a real token. If a token leaks, /revoke via @BotFather immediately.

# Required for real LLM responses
OPENAI_API_KEY=sk-...

# Required only for `python -m examples.ryuu_sensei.main --telegram`
# Create a bot via @BotFather in Telegram — it returns a token like:
#   1234567890:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_BOT_TOKEN=replace-me
